{
  "name": "sistema-fichaje-y-media",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite --host",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "server": "node server/index.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "idb": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-pwa": "^1.0.0"
  }
}
